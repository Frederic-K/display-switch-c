<Project>
  <!-- Publication recommandée : un seul DisplaySwitch.exe qui embarque le runtime .NET et WinForms.
       Rien à installer sur le PC cible. dotnet publish DisplaySwitch -p:PublishProfile=SelfContained -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Les quelques DLL natives du runtime vont aussi dans l'exe (extraites au premier lancement). -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Compression du contenu embarqué : exe plus petit, démarrage un peu plus lent. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>..\publish\self-contained\</PublishDir>
  </PropertyGroup>
</Project>
