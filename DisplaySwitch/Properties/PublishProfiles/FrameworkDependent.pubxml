<Project>
  <!-- Pour comparaison : petit exe, mais le « .NET Desktop Runtime 10 » doit être installé sur le PC cible.
       dotnet publish DisplaySwitch -p:PublishProfile=FrameworkDependent -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>..\publish\framework-dependent\</PublishDir>
  </PropertyGroup>
</Project>
