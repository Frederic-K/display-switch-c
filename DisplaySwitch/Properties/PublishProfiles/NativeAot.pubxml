<Project>
  <!-- Expérimental : compilation Native AOT (code machine, sans runtime JIT).
       WinForms n'est pas officiellement compatible avec le « trimming » exigé par Native AOT :
       le SDK refuse par défaut (erreur NETSDK1175), d'où la propriété de contournement ci-dessous.
       dotnet publish DisplaySwitch -p:PublishProfile=NativeAot -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <OptimizationPreference>Size</OptimizationPreference>
    <DebugType>none</DebugType>
    <PublishDir>..\publish\native-aot\</PublishDir>
  </PropertyGroup>
</Project>
